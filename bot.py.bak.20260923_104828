@bot.on(events.NewMessage(pattern=r'^/addadmin(\s|$)'))
async def add_admin_command(event):
    if not is_admin(event.sender_id):
        await event.reply(pe(f"❌ Admin only"), parse_mode='html')
        return
    
    parts = event.message.text.split()
    if len(parts) < 2:
        await event.reply(pe(
            f"[⌯] 𝗔𝗱𝗱 𝗔𝗱𝗺𝗶𝗻 ⌁ ➕\n{SEP}\n"
            f"[⌯] Usage ⌁ /addadmin chat_id\n"
            f"[⌯] Usage ⌁ /addadmin @username"
        ), parse_mode='html')
        return
    
    target = parts[1].strip()
    target_id = None
    
    try:
        target_id = int(target)
    except ValueError:
        if target.startswith('@'):
            try:
                entity = await bot.get_entity(target)
                target_id = entity.id
            except Exception as e:
                await event.reply(pe(f"❌ Could not find user: <code>{e}</code>"), parse_mode='html')
                return
        else:
            await event.reply(pe(f"❌ Invalid format. Use ID or @username"), parse_mode='html')
            return
    
    if not target_id:
        await event.reply(pe(f"❌ Could not resolve user."), parse_mode='html')
        return
    
    if target_id in ADMIN_IDS:
        await event.reply(pe(f"⚠️ User is already an admin."), parse_mode='html')
        return
    
    ADMIN_IDS.add(target_id)
    _save_admin_ids(ADMIN_IDS)
    
    await event.reply(pe(
        f"[⌯] 𝗔𝗱𝗺𝗶𝗻 ⌁ 𝙰𝚍𝚍𝚎𝚍 ⌁ 🔥\n"
        f"\n"
        f"{SEP}\n"
        f"[⌯] 𝗨𝘀𝗲𝗿 𝗜𝗗 ⌁ {target_id} ⌁ ✅\n"
        f"[⌯] 𝗥𝗼𝗹𝗲 ⌁ 𝙰𝚍𝚖𝚒𝚗 ⌁ ⚡"
    ), parse_mode='html')


@bot.on(events.NewMessage(pattern=r'^/rmadmin(\s|$)'))
async def remove_admin_command(event):
    if not is_admin(event.sender_id):
        await event.reply(pe(f"❌ Admin only"), parse_mode='html')
        return
    
    parts = event.message.text.split()
    if len(parts) < 2:
        await event.reply(pe(f"❌ Usage: /rmadmin chat_id"), parse_mode='html')
        return
    
    try:
        target_id = int(parts[1].strip())
    except:
        await event.reply(pe(f"❌ Invalid ID"), parse_mode='html')
        return
    
    if target_id == OWNER_ID:
        await event.reply(pe(f"❌ Cannot remove owner!"), parse_mode='html')
        return
    
    if target_id not in ADMIN_IDS:
        await event.reply(pe(f"⚠️ User is not an admin."), parse_mode='html')
        return
    
    ADMIN_IDS.discard(target_id)
    _save_admin_ids(ADMIN_IDS)
    
    await event.reply(pe(
        f"[⌯] 𝗔𝗱𝗺𝗶𝗻 ⌁ 𝗥𝗲𝗺𝗼𝘃𝗲𝗱 ⌁ ❌\n"
        f"\n"
        f"{SEP}\n"
        f"[⌯] 𝗨𝘀𝗲𝗿 𝗜𝗗 ⌁ {target_id}\n"
        f"[⌯] 𝗥𝗼𝗹𝗲 ⌁ 𝙼𝚎𝚖𝚋𝚎𝚛 ⌁ ⚡"
    ), parse_mode='html')


