        count     = int(parts[3])
    except ValueError:
        await event.reply(pe(f"❌ 𝗜𝗻𝘃𝗮𝗹𝗶𝗱 𝗻𝘂𝗺𝗯𝗲𝗿𝘀 ⌁ 𝗨𝘀𝗲 𝗱𝗶𝗴𝗶𝘁𝘀 𝗼𝗻𝗹𝘆"), parse_mode='html')
        return

    # ═══ Validate ranges ═════════════════════════════════════════════════════
    if not (1 <= days <= 365):
        await event.reply(pe(f"❌ 𝗗𝗮𝘆𝘀 𝗺𝘂𝘀𝘁 𝗯𝗲 𝟭-𝟯𝟲𝟱"), parse_mode='html')
        return
    if not (1 <= max_uses <= 100):
        await event.reply(pe(f"❌ 𝗠𝗮𝘅 𝘂𝘀𝗲𝘀 𝗺𝘂𝘀𝘁 𝗯𝗲 𝟭-𝟭𝟬𝟬"), parse_mode='html')
        return
    if not (1 <= count <= 50):
        await event.reply(pe(f"❌ 𝗖𝗼𝘂𝗻𝘁 𝗺𝘂𝘀𝘁 𝗯𝗲 𝟭-𝟱𝟬"), parse_mode='html')
        return

    # ═══ Use EXACT days user entered — no plan name override ════════════════
    plan_name = f"{days}-Day Plan"
    plan_duration = f"{days} Days"
    plan_key = "custom"
    # Keep a friendlier name only for display
    if days <= 1:
        plan_display = "Trial"
        plan_duration = "3 Hours"
    elif days == 7:
        plan_display = "Weekly"
    elif days == 15:
        plan_display = "Bi-Weekly"
    elif days == 30:
        plan_display = "Monthly"
    else:
        plan_display = f"{days}-Day"
    plan_name = plan_display

    # ═══ Generate keys ═══════════════════════════════════════════════════════
    keys = load_keys()
    generated = []
    key_chars = "ABCDEFGHIJKLMNOPQRSTUVWXYZ0123456789"

    for _ in range(count):
        # Ensure unique key (avoid collision)
        for _retry in range(10):
            parts_k = []
            for _ in range(3):
                part = ''.join(secrets.choice(key_chars) for _ in range(5))
                parts_k.append(part)
            key = f"RXP-{'-'.join(parts_k)}"
            if key not in keys:
                break

        keys[key] = {
            "plan": plan_key,
            "days": days,
            "max_uses": max_uses,
            "usage_count": 0,
            "created_at": time.time(),
            "redeemed_by": None,
            "redeemed_at": None,
        }
        generated.append(key)

    save_keys(keys)

    # ═══ Output ══════════════════════════════════════════════════════════════
    if count == 1:
        key = generated[0]
        await event.reply(pe(
            f"[⌯] 𝗞𝗲𝘆 ⌁ 𝙶𝚎𝚗𝚎𝚛𝚊𝚝𝚎𝚍 ⌁ ⚡\n"
            f"\n"
            f"{SEP}\n"
            f"[⌯] 𝗞𝗲𝘆 ⌁ <code>{key}</code>\n"
            f"[⌯] 𝗣𝗹𝗮𝗻 ⌁ {plan_name} ⌁ ⚡\n"
            f"[⌯] 𝗗𝘂𝗿𝗮𝘁𝗶𝗼𝗻 ⌁ {plan_duration} ⌁ ⚡\n"
            f"[⌯] 𝗠𝗮𝘅 𝗨𝘀𝗲𝘀 ⌁ {max_uses} ⌁ ⚡\n"
            f"\n"
            f"{SEP}\n"
            f"[⌯] 𝗥𝗲𝗱𝗲𝗲𝗺 ⌁ /redeem KEY ⌁ ⚡"
        ), parse_mode='html')
    else:
        # Show up to 20 keys in message, rest as file
        show_keys = generated[:20]
        key_list = "\n".join([f"[⌯] <code>{k}</code>" for k in show_keys])
        more = f"\n<i>...and {len(generated) - 20} more (sent as file)</i>" if len(generated) > 20 else ""

        await event.reply(pe(
            f"[⌯] 𝗞𝗲𝘆𝘀 ⌁ 𝙶𝚎𝚗𝚎𝚛𝚊𝚝𝗲𝗱 ⌁ {count} ⚡\n"
            f"\n"
            f"{SEP}\n"
            f"{key_list}{more}\n"
            f"\n"
            f"{SEP}\n"
            f"[⌯] 𝗣𝗹𝗮𝗻 ⌁ {plan_name} ⌁ ⚡\n"
            f"[⌯] 𝗗𝘂𝗿𝗮𝘁𝗶𝗼𝗻 ⌁ {plan_duration} ⌁ ⚡\n"
            f"[⌯] 𝗠𝗮𝘅 𝗨𝘀𝗲𝘀 ⌁ {max_uses} ⌁ ⚡\n"
            f"{SEP}\n"
            f"[⌯] 𝗥𝗲𝗱𝗲𝗲𝗺 ⌁ /redeem KEY ⌁ ⚡"
        ), parse_mode='html')

        # If > 20 keys, send full list as .txt file
        if len(generated) > 20:
            ts = int(time.time())
            filename = f"/tmp/rxo_uploads/keys_{ts}.txt"
            os.makedirs("/tmp/rxo_uploads", exist_ok=True)

            async with aiofiles.open(filename, 'w') as f:
                await f.write(f"# ═══════════════════════════════════════════\n")
                await f.write(f"# Generated Keys — {count} keys\n")
                await f.write(f"# Plan: {plan_name} ({days} days)\n")
                await f.write(f"# Max Uses: {max_uses} per key\n")
                await f.write(f"# Date: {datetime.now().strftime('%Y-%m-%d %H:%M:%S')}\n")
                await f.write(f"# ═══════════════════════════════════════════\n\n")
                for k in generated:
                    await f.write(f"{k}\n")

            try:
                await bot.send_file(
                    event.sender_id, filename,
                    caption=pe(f"[⌯] 𝗔𝗹𝗹 𝗞𝗲𝘆𝘀 ⌁ {count} ⌁ 🔑"),
                    parse_mode='html'
                )
            except Exception as e:
                print(f"[genkey] file send error: {e}")

            try:
                os.remove(filename)
            except Exception:
                pass


@bot.on(events.NewMessage(pattern=r'^/redeem\s+'))
async def redeem_key_command(event):
    uid = event.sender_id
    key = event.message.text.split(' ', 1)[1].strip() if ' ' in event.message.text else ''
    if not key:
        await event.reply(pe(f"🔑 Usage: /redeem [key]"), parse_mode='html')
        return

    keys = load_keys()
    if key not in keys:
        await event.reply(pe(f"❌ Invalid Key"), parse_mode='html')
        return

    key_data = keys[key]
    max_uses = key_data.get("max_uses", 1)
    usage_count = key_data.get("usage_count", 0)

    if key_data.get("redeemed_by") and usage_count >= max_uses:
        await event.reply(pe(f"❌ Key usage limit reached"), parse_mode='html')
        return

    if key_data.get("redeemed_by") and key_data.get("redeemed_by") != uid and max_uses <= 1:
        await event.reply(pe(f"❌ Key already used"), parse_mode='html')
        return

    plan_name = key_data.get("plan", "custom")
    days = key_data.get("days", 7)

    # Use exact days — do NOT let PLAN_TYPES override
    plan_def = {
        "name": plan_name.replace("_", "-").title() if plan_name else f"{days}-Day",
        "days": days,
        "duration_label": f"{days} Days",
    }

    # Call activate_plan with EXACT days from key
    activate_plan(uid, "key", plan_name, days, added_by=0)

    keys[key]["redeemed_by"] = uid
    keys[key]["redeemed_at"] = time.time()
    keys[key]["usage_count"] = usage_count + 1
    save_keys(keys)

    await event.reply(pe(
        f"[⌯] 𝗔𝗰𝗰𝗲𝘀𝘀 𝗚𝗿𝗮𝗻𝘁𝗲𝗱 ⌁ 🎉\n{SEP}\n"
