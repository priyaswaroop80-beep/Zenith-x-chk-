async def _run_filtersite(uid, sites, max_price):
    """Run the site filtering — scan all sites, save result to file."""
    proxies = load_proxies()
    if not proxies:
        await bot.send_message(uid, pe(f"❌ 𝗡𝗼 𝗽𝗿𝗼𝘅𝗶𝗲𝘀 𝗮𝘃𝗮𝗶𝗹𝗮𝗯𝗹𝗲"), parse_mode='html')
        return

    state = _filtersite_state.get(uid, {})
    # Use custom sites if provided
    if state.get('source') == 'custom' and state.get('sites'):
        sites = state['sites']

    total = len(sites)
    matched = []
    dead = []
    expensive = []

    # Progress message
    prog_msg_id = None
    try:
        prog_msg = await bot.send_message(uid, pe(
            f"[⌯] 𝗙𝗶𝗹𝘁𝗲𝗿 𝗦𝗶𝘁𝗲 ⌁ 𝗦𝗰𝗮𝗻𝗻𝗶𝗻𝗴 ⌁ 🔍\n"
            f"{SEP}\n"
            f"[⌯] 𝗧𝗼𝘁𝗮𝗹 ⌁ {total:,}\n"
            f"[⌯] 𝗦𝗰𝗮𝗻𝗻𝗲𝗱 ⌁ 0\n"
            f"[⌯] 𝗠𝗮𝘁𝗰𝗵𝗲𝗱 ⌁ 0\n"
            f"{SEP}\n"
            f"⏳ 𝗦𝘁𝗮𝗿𝘁𝗶𝗻𝗴..."
        ), parse_mode='html')
        prog_msg_id = prog_msg.id
    except Exception:
        pass

    last_update = time.time()
    sem = asyncio.Semaphore(20)  # 20 concurrent scans

    async def scan_one(site):
        async with sem:
            return await _scan_site_for_max_price(site, max_price, proxies)

    tasks = [asyncio.create_task(scan_one(s)) for s in sites]
    scanned = 0

    for coro in asyncio.as_completed(tasks):
        try:
            result = await coro
        except Exception:
            continue
        scanned += 1
        if result.get('ok'):
            matched.append(result)
        elif 'Expensive' in result.get('reason', ''):
            expensive.append(result)
        else:
            dead.append(result)

        # Update progress every 3 sec
        now = time.time()
        if now - last_update >= 3 and prog_msg_id:
            last_update = now
            pct = int(100 * scanned / total)
            try:
                await bot.edit_message(uid, prog_msg_id, pe(
                    f"[⌯] 𝗙𝗶𝗹𝘁𝗲𝗿 𝗦𝗶𝘁𝗲 ⌁ 𝗦𝗰𝗮𝗻𝗻𝗶𝗻𝗴 ⌁ 🔍\n"
