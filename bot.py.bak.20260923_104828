            status_display = "𝙲𝙰𝚁𝙳 𝙳𝙴𝙲𝙻𝙸𝙽𝙴𝙳"
            head = "[⌯] 𝗝𝗶𝗼 ⌁ 𝗖𝗮𝗿𝗱 𝗗𝗲𝗰𝗹𝗶𝗻𝗲𝗱 ⌁ ❌"
            msg = "Card declined by gateway"
            hit_type = None

        # Other card-related declines
        elif any(x in raw_msg_lower for x in ("decline", "insufficient", "invalid card", "expired", "do not honor", "not supported")):
            status_display = "𝙲𝙰𝚁𝙳 𝙳𝙴𝙲𝙻𝙸𝙽𝙴𝙳"
            head = "[⌯] 𝗝𝗶𝗼 ⌁ 𝗖𝗮𝗿𝗱 𝗗𝗲𝗰𝗹𝗶𝗻𝗲𝗱 ⌁ ❌"
            msg = raw_msg[:120]
            hit_type = None

        # Number / API error
        elif any(x in raw_msg_lower for x in ("number", "invalid number", "operator")):
            status_display = "𝙸𝙽𝚅𝙰𝙻𝙸𝙳 𝙽𝚄𝙼𝙱𝙴𝚁"
