def _is_txt_file(e):
    if not e.file or e.via_bot_id:
        return False
    name = e.file.name or ''
    mime = e.file.mime_type or ''
    return name.endswith('.txt') or (mime in ('text/plain', 'application/octet-stream') and name.endswith('.txt')) or (not name and mime == 'text/plain')


