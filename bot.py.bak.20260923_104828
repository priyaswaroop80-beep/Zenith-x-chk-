                except Exception:
                    pass
        upt = asyncio.create_task(upd())
        await asyncio.gather(*tasks, return_exceptions=True)
        upt.cancel()
    finally:
        JIO_ACTIVE.pop(uid, None)
        JIO_MASS_STATE.pop(uid, None)
        done = st['charged'] + st['declined'] + st['error']
        elapsed = int(time.time() - st['started_at'])
