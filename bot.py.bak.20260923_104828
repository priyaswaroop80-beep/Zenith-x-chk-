#  ▸ BACKGROUND CLEANUP — every hour
# ══════════════════════════════════════════════════════════════════════════════
async def _background_cleanup():
    while True:
        await asyncio.sleep(3600)  # every hour
        try:
            _startup_cleanup()
        except Exception as e:
            print(f"[BG-CLEANUP] error: {e}")

asyncio.get_event_loop().create_task(_background_cleanup()) if False else None

