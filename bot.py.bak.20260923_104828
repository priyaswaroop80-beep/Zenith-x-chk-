            head = "[⌯] 𝗝𝗶𝗼 ⌁ 𝗙𝗮𝗶𝗹𝗲𝗱 ⌁ ❌"
            msg = raw_msg[:120]
            hit_type = None

    # ═══ BIN info ═══
