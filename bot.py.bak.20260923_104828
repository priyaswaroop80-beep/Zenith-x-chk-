import threading as _cleanup_thread
import time as _cleanup_time

def _start_cleanup_daemon():
    def _cleanup():
        while True:
            try:
                _cleanup_time.sleep(300)  # every 5 min
                now = _cleanup_time.time()
                # Clean stale user_active_check (older than 30 min)
                stale = []
                for uid, info in list(user_active_check.items()):
                    if now - info.get('started_at', now) > 1800:
                        stale.append(uid)
                for uid in stale:
                    user_active_check.pop(uid, None)
                    print(f"[CLEANUP] Removed stale session for user {uid}")
                # Clean stale active_sessions (older than 30 min)
                stale2 = []
                for key, sess in list(active_sessions.items()):
                    if now - sess.get('started_at', now) > 1800:
                        stale2.append(key)
                for key in stale2:
                    active_sessions.pop(key, None)
                    print(f"[CLEANUP] Removed stale session: {key}")
                if stale or stale2:
                    print(f"[CLEANUP] Removed {len(stale)} users + {len(stale2)} sessions")
            except Exception as e:
                print(f"[CLEANUP] Error: {e}")
    _cleanup_thread.Thread(target=_cleanup, daemon=True).start()

_start_cleanup_daemon()


