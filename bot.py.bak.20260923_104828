                    f"[⌯] 𝗘𝘅𝗽𝗲𝗻𝘀𝗶𝘃𝗲 ⌁ {len(expensive)}\n"
                    f"[⌯] 𝗗𝗲𝗮𝗱 ⌁ {len(dead)}\n"
                    f"{SEP}\n"
                    f"⏳ 𝗦𝗰𝗮𝗻𝗻𝗶𝗻𝗴..."
                ), parse_mode='html')
            except Exception:
                pass

    # Save matched sites to file
    ts = int(time.time())
