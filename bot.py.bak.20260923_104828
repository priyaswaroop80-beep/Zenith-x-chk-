        for m in sorted(matched, key=lambda x: x.get('min_price', 0)):
            await f.write(f"{m['site']}\n")

    # Final summary
    try:
        await bot.edit_message(uid, prog_msg_id, pe(
            f"[⌯] 𝗙𝗶𝗹𝘁𝗲𝗿 𝗦𝗶𝘁𝗲 ⌁ 𝗖𝗼𝗺𝗽𝗹𝗲𝘁𝗲 ⌁ ✅\n"
