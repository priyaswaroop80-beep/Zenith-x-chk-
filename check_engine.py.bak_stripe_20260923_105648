def extract_cards_from_text(text):
    patterns = [
        r'(\d{13,19})\s*\|\s*(\d{1,2})\s*\|\s*(\d{2,4})\s*\|\s*(\d{3,4})',
        r'(\d{13,19})\s*\/\s*(\d{1,2})\s*\/\s*(\d{2,4})\s*\/\s*(\d{3,4})',
        r'(\d{13,19})\s*:\s*(\d{1,2})\s*:\s*(\d{2,4})\s*:\s*(\d{3,4})',
        r'(\d{13,19})\s+(\d{1,2})\s+(\d{2,4})\s+(\d{3,4})',
        r'(\d{13,19})\s*=\s*(\d{1,2})\s*=\s*(\d{2,4})\s*=\s*(\d{3,4})',
    ]
    cards = []
    for pattern in patterns:
        for match in re.findall(pattern, text):
            if len(match) == 4:
                cc, mm, yy, cvv = match
                mm = mm.zfill(2)
                if len(yy) == 4:
                    yy = yy[2:]
                card = f"{cc}|{mm}|{yy}|{cvv}"
                if card not in cards:
                    cards.append(card)
    return cards

